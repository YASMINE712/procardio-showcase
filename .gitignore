# Allow only the intentionally authored public case-study material.
/*
!/.gitignore
!/README.md
!/docs/
!/pseudocode/
!/assets/
/docs/*
!/docs/*.md
/pseudocode/*
!/pseudocode/*.md
/assets/*
!/assets/banner.svg
!/assets/architecture.svg
!/assets/tenant-isolation.svg
!/assets/data-pipeline.svg
!/assets/rag-pipeline.svg
!/assets/training-lifecycle.svg
!/assets/request-flow.svg
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/showcase-checks.yml

!/assets/screenshots/
/assets/screenshots/*
!/examples/
/examples/*
!/assets/screenshots/login.png
!/assets/screenshots/registration.png
!/assets/screenshots/dashboard.png
!/assets/screenshots/ecg-workflow.png
!/assets/screenshots/coronary-editor.png
!/assets/screenshots/hemodynamics.png
!/assets/screenshots/backoffice.png
!/assets/screenshots/proia-review.png
!/examples/procardio-demo-report.pdf
!/assets/report-preview.png
!/assets/validation-curves.png
